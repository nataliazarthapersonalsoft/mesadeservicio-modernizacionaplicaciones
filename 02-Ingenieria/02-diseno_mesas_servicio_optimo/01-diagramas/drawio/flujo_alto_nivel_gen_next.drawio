        <mxCell id="G_hdr" value="G &#183; CIERRE Y SATISFACCI&#211;N  (XLA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#437A22;strokeColor=#437A22;strokeWidth=2;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;fontColor=#FFFFFF;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="910" width="680" height="55" as="geometry"/></mxCell>
        <mxCell id="G_body" value="&#8226; Verificaci&#243;n con usuario final&lt;br/&gt;&#8226; CSAT post-cierre autom&#225;tico&lt;br/&gt;&#8226; Medici&#243;n XLA (experiencia real)&lt;br/&gt;&#8226; Cierre con categor&#237;as en herramienta&lt;br/&gt;&#8226; Victorias tempranas cada 15 d&#237;as&lt;br/&gt;&#8226; Reporte mensual al cliente&lt;br/&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D8EFC8;strokeColor=#437A22;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="965" width="680" height="295" as="geometry"/></mxCell>
