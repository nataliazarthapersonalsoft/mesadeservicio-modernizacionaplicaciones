        <mxCell id="H_body" value="&#8226; Gesti&#243;n de tickets (cliente o PS)&lt;br/&gt;&#8226; Base de conocimiento integrada&lt;br/&gt;&#8226; Dashboards KPI / SLA / XLA&lt;br/&gt;&#8226; Portal de autoservicio N0&lt;br/&gt;&#8226; Integraci&#243;n IA (clasificaci&#243;n)&lt;br/&gt;&#8226; Herramienta del cliente primero&lt;br/&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8E8D0;strokeColor=#6B6B3A;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1420" y="965" width="680" height="295" as="geometry"/></mxCell>
        <mxCell id="I_hdr" value="I &#183; ROLES Y RACI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A84B2F;strokeColor=#A84B2F;strokeWidth=2;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;fontColor=#FFFFFF;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2120" y="910" width="680" height="55" as="geometry"/></mxCell>
        <mxCell id="I_body" value="&#8226; Gerente de Mesa: gobierno y cliente&lt;br/&gt;&#8226; L&#237;der T&#233;cnico: coordinaci&#243;n y calidad&lt;br/&gt;&#8226; Analista N1: atenci&#243;n y registro&lt;br/&gt;&#8226; Especialista N2: diagn&#243;stico t&#233;cnico&lt;br/&gt;&#8226; Dev Senior N3: resoluci&#243;n cr&#237;tica&lt;br/&gt;&#8226; Esp. IA/Datos: AIOps y automatizaci&#243;n&lt;br/&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0D8D2;strokeColor=#A84B2F;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="2120" y="965" width="680" height="295" as="geometry"/></mxCell>
        <mxCell id="J_hdr" value="J &#183; SABORES Y PRICING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B8860B;strokeColor=#B8860B;strokeWidth=2;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;fontColor=#FFFFFF;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2820" y="910" width="360" height="55" as="geometry"/></mxCell>
        <mxCell id="J_body" value="&#8226; Dedicado: 100% un cliente&lt;br/&gt;&#8226; Compartido: capacidad parcial&lt;br/&gt;&#8226; Express Alfa: piloto / nuevos&lt;br/&gt;&#8226; Full Gen Next: completo&lt;br/&gt;&#8226; Pricing: FTE &#8594; Ticket &#8594; Outcome&lt;br/&gt;&#8226; Licencias: cliente o PS&lt;br/&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3B0;strokeColor=#B8860B;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="2820" y="965" width="360" height="295" as="geometry"/></mxCell>
        <mxCell id="K_hdr" value="K &#183; GOBIERNO DEL SERVICIO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B474D;strokeColor=#1B474D;strokeWidth=2;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;fontColor=#FFFFFF;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="1300" width="820" height="55" as="geometry"/></mxCell>
        <mxCell id="K_body" value="&#8226; RACI completo por proceso&lt;br/&gt;&#8226; Service Review mensual con cliente&lt;br/&gt;&#8226; Cumplimiento SFC (Circular 007, Open Finance)&lt;br/&gt;&#8226; Trazabilidad IA (ISO 42001)&lt;br/&gt;&#8226; Plan de cuenta y control de crecimiento&lt;br/&gt;&#8226; Mejora continua ITIL v5 (ciclo 6 pasos)&lt;br/&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEAE6;strokeColor=#1B474D;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="1355" width="820" height="295" as="geometry"/></mxCell>
        <mxCell id="L_hdr" value="L &#183; KPIs Y SLA EST&#193;NDAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#20808D;strokeColor=#20808D;strokeWidth=2;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;fontColor=#FFFFFF;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="1300" width="820" height="55" as="geometry"/></mxCell>
        <mxCell id="L_body" value="&#8226; FCR &gt; 75%   |   MTTR N1 &lt; 4h  |  N2 &lt; 8h&lt;br/&gt;&#8226; CSAT &gt; 85%   |   XLA medido mensual&lt;br/&gt;&#8226; Deflecci&#243;n N0 &gt; 30%   |   SLA P1 &lt; 1h&lt;br/&gt;&#8226; Automatizaci&#243;n &gt; 20% de tickets&lt;br/&gt;&#8226; Reducci&#243;n tickets recurrentes (KEDB)&lt;br/&gt;&#8226; FTE: esfuerzo real vs. estimado&lt;br/&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E8EC;strokeColor=#20808D;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="1355" width="820" height="295" as="geometry"/></mxCell>
