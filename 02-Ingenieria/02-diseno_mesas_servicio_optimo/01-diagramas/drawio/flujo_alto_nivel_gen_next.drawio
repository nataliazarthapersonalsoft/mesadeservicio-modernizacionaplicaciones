        <mxCell id="E_hdr" value="E &#183; KNOWLEDGE HUB  (KEDB + KCS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7A39BB;strokeColor=#7A39BB;strokeWidth=2;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;fontColor=#FFFFFF;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="880" height="55" as="geometry"/></mxCell>
        <mxCell id="E_body" value="&#8226; Base construida con el cliente (transici&#243;n)&lt;br/&gt;&#8226; Art&#237;culo nuevo por ticket cerrado (KCS)&lt;br/&gt;&#8226; IA genera y prioriza art&#237;culos&lt;br/&gt;&#8226; Alimenta N0 en tiempo real&lt;br/&gt;&#8226; Versi&#243;n por nivel: N1 / N2 / N3&lt;br/&gt;&#8226; Retroalimentaci&#243;n activa del equipo&lt;br/&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAFA;strokeColor=#7A39BB;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="545" width="880" height="325" as="geometry"/></mxCell>
        <mxCell id="N1_hdr" value="N1 &#183; FRONT-END  (Mesa de Ayuda)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#20808D;strokeColor=#20808D;strokeWidth=2;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;fontColor=#FFFFFF;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="490" width="840" height="55" as="geometry"/></mxCell>
        <mxCell id="N1_body" value="&#8226; Analista / T&#233;cnico junior&lt;br/&gt;&#8226; Recepci&#243;n y registro del caso&lt;br/&gt;&#8226; Resoluci&#243;n con KEDB (gu&#237;as, scripts)&lt;br/&gt;&#8226; FCR objetivo &gt; 75%&lt;br/&gt;&#8226; Agent Assist IA (sugerencias inline)&lt;br/&gt;&#8226; Escala a N2 si supera SLA&lt;br/&gt;&lt;br/&gt;&lt;i&gt;&lt;b&gt;&lt;font color=&quot;#20808D&quot;&gt;SLA: 4h normal  |  1h cr&#237;tico P1&lt;/font&gt;&lt;/b&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E8EC;strokeColor=#20808D;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="920" y="545" width="840" height="325" as="geometry"/></mxCell>
        <mxCell id="N2_hdr" value="N2 &#183; SOPORTE ESPECIALIZADO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A84B2F;strokeColor=#A84B2F;strokeWidth=2;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;fontColor=#FFFFFF;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1780" y="490" width="840" height="55" as="geometry"/></mxCell>
        <mxCell id="N2_body" value="&#8226; T&#233;cnico senior / Especialista&lt;br/&gt;&#8226; Diagn&#243;stico profundo&lt;br/&gt;&#8226; HW, VPN, BD, integraciones&lt;br/&gt;&#8226; Soporte en campo si es necesario&lt;br/&gt;&#8226; Recuperaci&#243;n de backups&lt;br/&gt;&#8226; Escala a N3 si afecta PDN&lt;br/&gt;&lt;br/&gt;&lt;i&gt;&lt;b&gt;&lt;font color=&quot;#A84B2F&quot;&gt;SLA: 8h normal  |  4h alto impacto&lt;/font&gt;&lt;/b&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0D8D2;strokeColor=#A84B2F;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1780" y="545" width="840" height="325" as="geometry"/></mxCell>
        <mxCell id="N3_hdr" value="N3 &#183; BACK-END  (Mesa de Soporte)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B474D;strokeColor=#1B474D;strokeWidth=2;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;fontColor=#FFFFFF;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2640" y="490" width="540" height="55" as="geometry"/></mxCell>
        <mxCell id="N3_body" value="&#8226; Dev senior / Especialista dominio&lt;br/&gt;&#8226; Incidentes PDN / continuidad negocio&lt;br/&gt;&#8226; Parches y correcciones de c&#243;digo&lt;br/&gt;&#8226; Config. servidores, BD, seguridad&lt;br/&gt;&#8226; Relaci&#243;n con proveedores externos&lt;br/&gt;&#8226; Vulnerabilidades y ciberataques&lt;br/&gt;&lt;br/&gt;&lt;i&gt;&lt;b&gt;&lt;font color=&quot;#1B474D&quot;&gt;P1 &lt; 1h  |  P2 &lt; 4h  |  RCA obligatorio&lt;/font&gt;&lt;/b&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEAE6;strokeColor=#1B474D;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="2640" y="545" width="540" height="325" as="geometry"/></mxCell>
        <mxCell id="F_hdr" value="F &#183; AIOps  (Operaci&#243;n Inteligente)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#006494;strokeColor=#006494;strokeWidth=2;fontSize=15;fontFamily=Arial;align=center;verticalAlign=middle;fontColor=#FFFFFF;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="680" height="55" as="geometry"/></mxCell>
        <mxCell id="F_body" value="&#8226; Monitoreo continuo de apps y servicios&lt;br/&gt;&#8226; Detecci&#243;n temprana de anomal&#237;as&lt;br/&gt;&#8226; Correlaci&#243;n de eventos multi-fuente&lt;br/&gt;&#8226; Auto-remediaci&#243;n predefinida&lt;br/&gt;&#8226; Genera tickets autom&#225;ticamente&lt;br/&gt;&#8226; Dashboards predictivos en tiempo real&lt;br/&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E0F0;strokeColor=#006494;strokeWidth=2;fontSize=13;fontFamily=Arial;align=left;verticalAlign=top;fontColor=#1C1914;spacingTop=6;spacingLeft=10;spacingRight=10;fontStyle=0;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="965" width="680" height="295" as="geometry"/></mxCell>
